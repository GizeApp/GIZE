{
  "appId": "ar.com.gize.app",
  "appName": "GIZE",
  "webDir": "www",
  "backgroundColor": "#000000",
  "android": {
    "backgroundColor": "#000000",
    "adjustMarginsForEdgeToEdge": "auto",
    "useLegacyBridge": true,
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/browser",
      "@capacitor/filesystem",
      "@capacitor/local-notifications",
      "@capacitor/push-notifications",
      "@capacitor/share",
      "@capgo/capacitor-health",
      "@capgo/capacitor-social-login"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": true,
        "twitter": false
      }
    }
  }
}
