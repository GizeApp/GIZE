{
  "appId": "ar.com.gize.app",
  "appName": "GIZE",
  "webDir": "www",
  "backgroundColor": "#000000",
  "android": {
    "backgroundColor": "#000000",
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": true,
        "twitter": false
      }
    }
  }
}
