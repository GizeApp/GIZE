# Imagen de Postgres de la copia de seguridad (.github/workflows/backup.yml). Recibe la URI de la
# base de producción y arma la copia, así que va fijada por digest: un tag se puede mover, un
# digest no. Dependabot abre un PR cuando sale una nueva (.github/dependabot.yml).
# Este digest es el de postgres:18 que usó la copia del 5/10/2026.
FROM postgres:18@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722
