<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «GIZE de hoy», chico (2×2): lo mismo que el mediano (widget_gize.xml), apretado y sin
     los textos de abajo. Cada parte abre GIZE en su lugar, como en el mediano. Los ids son los
     del mediano. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_izq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/widget_pasos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/widget_anillo"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="82"
                android:progressDrawable="@drawable/widget_anillo" />

            <!-- El número (o «Conectá») en una sola línea: la letra se achica sola si no entra. -->
            <TextView
                android:id="@+id/widget_pasos_txt"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/widget_ej_pasos"
                android:textColor="@color/widget_texto"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_racha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_llama"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/widget_racha"
                android:src="@drawable/widget_llama" />

            <TextView
                android:id="@+id/widget_racha_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="@string/widget_ej_racha"
                android:textColor="@color/widget_violeta"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_entreno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_entreno_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_ej_titulo"
            android:textColor="@color/widget_azul"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_entreno_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_ej_nombre"
            android:textColor="@color/widget_texto"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
